        }
      }
    },
    "Decisione non firmata. Riprova; se hai cambiato Face ID, accoppia di nuovo questo iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decision not signed. Try again; if you changed Face ID, pair this iPhone again."
          }
        }
      }
    },
    "Decisione non inviata. Controlla la connessione e riprova." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decision not sent. Check the connection and try again."
          }
        }
      }
    },
    "Deve essere uguale a quello su «%@»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It must match the one on “%@”."
