    "Fotocamera non disponibile" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera Unavailable"
          }
        }
      }
    },
    "I Mac accoppiati cancellano la chiave e i dati in iCloud. Per usare di nuovo il Telecomando dovrai accoppiare da capo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The paired Macs delete the key and the data in iCloud. To use the Remote again, you'll need to pair from scratch."
          }
        }
      }
    },
    "Il Mac dorme, visto %@: i dati possono essere vecchi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac is asleep, seen %@: data may be out of date"
