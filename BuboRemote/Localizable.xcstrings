      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow just this once"
          }
        }
      }
    },
    "Cosa arriva sull'iPhone" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
