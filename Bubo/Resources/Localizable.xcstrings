        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A more natural voice for the spoken summary. OpenAI gets only the summary's text, with your key, and the cost goes on your account. If OpenAI doesn't answer, Bubo speaks with the Mac's voices."
          }
        }
      }
