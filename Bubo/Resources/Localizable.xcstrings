        }
      }
    },
    "L'audio resta sul Mac, mai nel Secondo cervello. Nella nota c'è sempre la trascrizione." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio stays on the Mac, never in your second brain. The note always has the transcript."
          }
