        }
      }
    },
    "Larghezza della pagina, con lo user agent del dispositivo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page width, with the device’s user agent"
          }
        }
