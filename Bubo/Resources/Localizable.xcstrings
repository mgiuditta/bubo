    },
    "L'indice è quasi pieno. Oltre %lld righe o %@ Claude non carica il resto: accorcialo o chiedi a Claude di riordinarlo." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'indice è quasi pieno. Oltre %1$lld righe o %2$@ Claude non carica il resto: accorcialo o chiedi a Claude di riordinarlo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The index is almost full. Past %1$lld lines or %2$@, Claude doesn’t load the rest: shorten it or ask Claude to tidy it up."
          }
        }
      }
    },
    "L'issue %@ ha già una Sessione: «%@»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issue %@ already has a Session: “%@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'issue %1$@ ha già una Sessione: «%2$@»."
          }
        }
      }
    },
    "La API key è salvata, ma serve comunque Claude Code." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API key is saved, but Claude Code is still needed."
          }
        }
      }
    },
    "La PR punta a %@, non al branch di default %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PR targets %1$@, not the default branch %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La PR punta a %1$@, non al branch di default %2$@."
          }
        }
      }
    },
    "La Sessione non ha modifiche rispetto al branch da cui è partita." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Session has no changes compared with the branch it started from."
          }
        }
      }
    },
    "La Sessione non ha un branch suo: non c'è niente da proporre in una PR." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Session has no branch of its own: there’s nothing to propose in a PR."
          }
        }
      }
    },
    "La Sessione viene tolta dall'elenco. I file del Progetto non vengono toccati." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Session is removed from the list. The Project's files aren't touched."
          }
        }
      }
    },
    "La Sessione è appena stata fusa. Nuova Sessione parte da capo su un branch nuovo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Session was just merged. New Session starts over on a new branch."
          }
        }
      }
    },
    "La cancella dal Portachiavi di questo Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes it from this Mac's keychain."
          }
        }
      }
    },
    "La cartella %@ è nuova: le Sessioni al lavoro adesso la vedranno dal prossimo turno." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder %@ is new: Sessions working now will see it from their next turn."
          }
        }
      }
    },
    "La chiave non funziona" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Key Doesn't Work"
          }
        }
      }
    },
    "La chiave resta nel Portachiavi di questo Mac e non va su iCloud. Bubo non la usa mai da solo: si paga a consumo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key stays in this Mac's keychain and never goes to iCloud. Bubo never uses it on its own, because it's billed per use."
          }
        }
      }
    },
    "La chiave resta nel Portachiavi di questo Mac e si paga a consumo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key stays in this Mac's keychain, and you pay per use."
          }
        }
      }
    },
    "La chiede un subagente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A subagent is asking."
          }
        }
      }
    },
    "La copia isolata della Sessione non è più in %@. Cancella la Sessione per toglierla dall'elenco." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Session's isolated copy is no longer at %@. Delete the Session to remove it from the list."
          }
        }
      }
    },
    "La memoria è cambiata su disco. Chiudi e riapri il ricordo per vedere la versione nuova." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The memory changed on disk. Close it and open it again to see the new version."
          }
        }
      }
    },
    "La tua domanda aspetta qui e parte da sola appena Claude Code è pronto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your question waits here and starts on its own as soon as Claude Code is ready."
          }
