    },
    "L'agente risolve i conflitti con %@ nella copia della Sessione. Poi rivedi i blocchi nuovi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent is resolving the conflicts with %@ in the Session's copy. Then review the new blocks."
