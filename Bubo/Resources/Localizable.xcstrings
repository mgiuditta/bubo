{
  "sourceLanguage" : "it",
  "strings" : {
    "%@" : {
      "shouldTranslate" : false
    },
    "%@\n\nFile del Progetto da guardare:\n%@" : {
      "comment" : "First prompt of a Sessione from a Domanda's files: the request, then their paths in the Progetto, one per line",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nProject files to look at:\n%2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@\n\nFile del Progetto da guardare:\n%2$@"
          }
        }
      }
    },
    "%@ (da compilare)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (required)"
          }
        }
      }
    },
    "%@ a listino" : {
      "comment" : "Cost of an answer at list price, included in the subscription.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ at list price"
          }
        }
      }
    },
    "%@ a listino, incluso nell'abbonamento" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ at list price, included in your subscription"
          }
        }
      }
    },
    "%@ della finestra di 5 ore" : {
      "comment" : "Cost of an answer as a share of the subscription's 5-hour window.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ of the 5-hour window"
          }
        }
      }
    },
    "%@ di %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ of %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ di %2$@"
          }
        }
      }
    },
    "%@ diventa:" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ becomes:"
          }
        }
      }
    },
    "%@ non può andare a capo. Scrivilo su una riga sola." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't contain line breaks. Write it on one line."
          }
        }
      }
    },
    "%@ non è JSON valido e Bubo non lo tocca. Correggilo o spostalo, poi riprova." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn't valid JSON, so Bubo won't touch it. Fix or move it, then try again."
          }
        }
      }
    },
    "%@ o %@ → %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ o %2$@ → %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ or %2$@ → %3$@"
          }
        }
      }
    },
    "%@ riceve il testo della Domanda e degli allegati che hai confermato, mai modifiche o memoria dei Progetti, e la risposta si paga sulla tua chiave. Puoi revocare il consenso in Impostazioni › Modelli." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ receives the text of the Question and of the attachments you confirmed, never changes or Project memory, and the answer is paid with your key. You can revoke consent in Settings › Models."
          }
        }
      }
    },
    "%@ riceve solo il testo della Domanda, mai file, modifiche o memoria dei Progetti, e la risposta si paga sulla tua chiave. Puoi revocare il consenso in Impostazioni › Modelli." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ receives only the text of the question, never files, changes or project memory, and the answer is paid on your key. You can revoke consent in Settings › Models."
          }
        }
      }
    },
    "%@ token" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tokens"
          }
        }
      }
    },
    "%@ token sulla tua chiave" : {
      "comment" : "Cost of an answer from another provider, paid on the user's own key at a price Bubo does not know: the tokens used.",
      "localizations" : {
        "en" : {
