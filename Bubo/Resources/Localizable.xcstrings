    },
    "L'autore non ha cambiato versione: questa è già l'ultima che pubblica." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The author hasn't changed the version: this is already the latest they publish."
          }
        }
      }
    },
    "L'Indice cerca per parole e per significato." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Index searches by words and by meaning."
          }
        }
      }
    },
    "L'indice è quasi pieno. Oltre %lld righe o %@ Claude non carica il resto: accorcialo o chiedi a Claude di riordinarlo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The index is almost full. Past %1$lld lines or %2$@, Claude doesn’t load the rest: shorten it or ask Claude to tidy it up."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'indice è quasi pieno. Oltre %1$lld righe o %2$@ Claude non carica il resto: accorcialo o chiedi a Claude di riordinarlo."
          }
        }
      }
    },
    "L'Indice ha %@ frammenti, oltre i %@ previsti: le ricerche rallentano. Escludi le cartelle che non ti servono." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Index has %1$@ fragments, more than the %2$@ it's designed for: searches are slower. Exclude the folders you don't need."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'Indice ha %1$@ frammenti, oltre i %2$@ previsti: le ricerche rallentano. Escludi le cartelle che non ti servono."
          }
        }
      }
    },
    "L'Indice non legge queste cartelle. Le note restano dove sono." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Index doesn't read these folders. Your notes stay where they are."
          }
        }
      }
    },
    "L'iPhone non vedrà più le Sessioni di questo Mac e non potrà decidere le Richieste. La chiave condivisa viene cancellata e i dati in iCloud vengono eliminati." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPhone will no longer see this Mac's Sessions or decide its Requests. The shared key is deleted and the data in iCloud is removed."
          }
        }
      }
    },
    "L'issue %@ ha già una Sessione: «%@»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issue %@ already has a Session: “%@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'issue %1$@ ha già una Sessione: «%2$@»."
          }
        }
      }
    },
    "L'Orb sfuma invece di cambiare forma e si muove più piano." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Orb fades instead of changing shape and moves more slowly."
          }
