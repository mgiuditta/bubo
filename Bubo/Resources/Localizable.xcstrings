      }
    },
    "GitHub CLI non ha risposto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI didn't respond."
          }
        }
      }
    },
    "GitHub CLI non ha un accesso a %@. Accedi con «gh auth login» nel Terminale, poi riprova. Un token messo solo in GH_TOKEN nel profilo della shell non arriva a Bubo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI isn't signed in to %@. Sign in with “gh auth login” in Terminal, then try again. A token set only in GH_TOKEN in your shell profile doesn't reach Bubo."
          }
        }
      }
    },
    "GitHub ha rifiutato il push perché cambia .github/workflows e l'accesso di GitHub CLI non ha il permesso «workflow». Aggiungilo con «gh auth refresh -s workflow» nel Terminale, poi riprova." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub refused the push because it changes .github/workflows and GitHub CLI's sign-in doesn't have the “workflow” scope. Add it with “gh auth refresh -s workflow” in Terminal, then try again."
          }
        }
      }
    },
