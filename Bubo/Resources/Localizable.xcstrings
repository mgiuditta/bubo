    "La PR #%lld è stata chiusa su GitHub senza merge." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR #%lld was closed on GitHub without a merge."
          }
        }
      }
    },
    "La PR punta a %@, non al branch di default %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PR targets %1$@, not the default branch %2$@."
          }
