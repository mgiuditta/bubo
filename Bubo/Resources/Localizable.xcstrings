    },
    "La Sessione non è partita. Riprova." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Session didn't start. Try again."
          }
        }
      }
    },
    "La Sessione non ha modifiche rispetto al branch da cui è partita." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Session has no changes compared with the branch it started from."
          }
        }
