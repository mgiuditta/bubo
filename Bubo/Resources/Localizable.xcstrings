    "L'accesso è scaduto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in has expired."
          }
        }
      }
    },
    "L'agente non ha risolto i conflitti in %@. Ho rimesso la copia della Sessione com'era." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent didn't resolve the conflicts in %@. The Session's copy is back as it was."
          }
        }
      }
    },
    "L'agente risolve i conflitti con %@ nella copia della Sessione. Poi rivedi i blocchi nuovi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent is resolving the conflicts with %@ in the Session's copy. Then review the new blocks."
          }
        }
      }
    },
    "L'agente usa l'anteprima" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent is using the preview"
          }
        }
      }
    },
    "L'issue %@ ha già una Sessione: «%@»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issue %@ already has a Session: “%@”."
          }
        },
