          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "Bubo usa il login di Claude Code e non vede mai password né token.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bubo uses your Claude Code login and never sees passwords or tokens."
          }
        }
      }
    },
    "Uscire da Claude?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log out of Claude?"
          }
        }
      }
    },
    "Esci": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log Out"
          }
        }
      }
    },
    "Esci…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log Out…"
          }
        }
      }
    },
    "Le Sessioni si fermano finché non accedi di nuovo. Vale anche per `claude` nel Terminale.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions stop until you log in again. This also logs out `claude` in Terminal."
          }
        }
      }
    },
    "Controllo l'account…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your account…"
          }
        }
      }
    },
    "Collegato come %@ · %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged in as %1$@ · %2$@"
